{
  "name": "mobinexcorpadmin",
  "private": true,
  "version": "1.0.1",
  "description": "MobinexCorpAdmin - Standalone Desktop App for Device IMEI, Vendors, and Total Sales Records",
  "author": "MobinexCorpAdmin Team",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:build": "vite build && npx electron-builder",
    "dist": "vite build && electron-builder --win --x64",
    "update": "node updater.js",
    "publish:update": "node scripts/publish-update.mjs",
    "configure:updates": "node scripts/configure-updates.mjs"
  },
  "build": {
    "appId": "com.mobinexcorpadmin.app",
    "productName": "MobinexCorpAdmin",
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MobinexCorpAdmin",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mobinexcorp",
        "repo": "AdminApp"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
